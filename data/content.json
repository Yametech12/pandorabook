    },
    {
      "term": "Devotion",
      "definition": "The fourth emotional trigger in the sequence; represents complete surrender and loyalty."
    },
    {
      "term": "Dimensional Axis",
      "definition": "One of three binary dimensions (T/N, D/J, R/I) defining the agent type space."
    },
    {
      "term": "Dismissive-Avoidant",
      "definition": "Attachment style characterized by discomfort with closeness and emphasis on independence."
    },
    {
      "term": "Anxious-Avoidant",
      "definition": "Attachment style characterized by craving intimacy while fearing engulfment."
    },
    {
      "term": "Anxious-Preoccupied",
      "definition": "Attachment style characterized by craving closeness while fearing abandonment."
    },
    {
      "term": "Emotional Idealism",
      "definition": "NDI's primary defense — seeing potential in partners while overlooking flaws."
    },
    {
      "term": "Emotional Invisibility",
      "definition": "TDI's primary defense — modest presentation and observer positioning to avoid premature attention."
    },
    {
      "term": "Escalation Ladder",
      "definition": "Ordered levels of physical intimacy progression, each with behaviors, timing, and resistance indicators."
    },
    {
      "term": "FOMO",
      "definition": "Fear of Missing Out; TJI's core fear driving constant activity."
    },
    {
      "term": "Idealist (I)",
      "definition": "Romantic-projection pole of the Relational Worldview axis."
    },
    {
      "term": "Internal Process",
      "definition": "The modeled inner monologue during a behavioral state."
    },
