  "glossary": [
    {
      "term": "Activation Threshold",
      "definition": "The modeled stimulus intensity (0.0–1.0) required to trigger an emotional state transition."
    },
    {
      "term": "Archetype",
      "definition": "The narrative label for an agent type (e.g., \"The Iceberg\")."
    },
    {
      "term": "Behavioral State Machine",
      "definition": "A finite-state model describing an agent's behavioral modes, transition triggers, and exit conditions."
    },
    {
      "term": "Blank Expression Tolerance",
      "definition": "The ability to maintain a neutral facial expression under social pressure; used as a passive test."
    },
    {
      "term": "Butterfly Flight",
      "definition": "TJI's primary withdrawal pattern — leaving a social situation or redirecting attention when pressured."
    },
    {
      "term": "Cautious Investment",
      "definition": "NDI's secondary defense — slow trust-building with authenticity verification."
    },
    {
      "term": "Denier (D)",
